# GlycoTwin — Environment Variables Template
# Copy this file to .env and edit as needed.
# The .env file is excluded from git (see .gitignore).
#
# For this local prototype, no environment variables are strictly required.
# All secrets below are optional configuration overrides.

# ── Database ──────────────────────────────────────────────────────────────────
# Override the default SQLite path (default: instance/glycotwin.db)
# GLYCOTWIN_DB_PATH=instance/glycotwin.db

# ── Streamlit ─────────────────────────────────────────────────────────────────
# Port to run the dashboard on (default: 8501)
# STREAMLIT_SERVER_PORT=8501

# ── Security (prototype only) ─────────────────────────────────────────────────
# For production use, replace this with a cryptographically generated key.
# python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET_KEY=

# ── Data paths ────────────────────────────────────────────────────────────────
# Override default dataset path (default: data/raw/cgmacros/CGMacros)
# CGMACROS_DATA_DIR=data/raw/cgmacros/CGMacros

# ── Model path ────────────────────────────────────────────────────────────────
# Override default model artifact path
# GLYCOTWIN_MODEL_PATH=models/glycotwin_logistic_calibrated.pkl

# ── Research / Debug ──────────────────────────────────────────────────────────
# Set to 1 to enable verbose logging
# GLYCOTWIN_DEBUG=0
